        "import streamlit as st\n",
        "import pandas as pd\n",
        "\n",
        "st.set_page_config(\n",
        "    page_title=\"Student Performance Tracker\",\n",
        "    page_icon=\"🎓\",\n",
        "    layout=\"wide\"\n",
        ")\n",
        "\n",
        "st.title(\"🎓 Student Performance Tracker\")\n",
        "\n",
        "st.write(\"Enter student details and marks to track performance.\")\n",
        "\n",
        "# Input Section\n",
        "name = st.text_input(\"Student Name\")\n",
        "\n",
        "maths = st.number_input(\"Math Marks\", min_value=0, max_value=100, value=0)\n",
        "science = st.number_input(\"Science Marks\", min_value=0, max_value=100, value=0)\n",
        "english = st.number_input(\"English Marks\", min_value=0, max_value=100, value=0)\n",
        "\n",
        "if \"students\" not in st.session_state:\n",
        "    st.session_state.students = []\n",
        "\n",
        "if st.button(\"Add Student\"):\n",
        "\n",
        "    total = maths + science + english\n",
        "    average = total / 3\n",
        "\n",
        "    if average >= 90:\n",
        "        grade = \"A+\"\n",
        "    elif average >= 80:\n",
        "        grade = \"A\"\n",
        "    elif average >= 70:\n",
        "        grade = \"B\"\n",
        "    elif average >= 60:\n",
        "        grade = \"C\"\n",
        "    elif average >= 50:\n",
        "        grade = \"D\"\n",
        "    else:\n",
        "        grade = \"F\"\n",
        "\n",
        "    st.session_state.students.append({\n",
        "        \"Name\": name,\n",
        "        \"Math\": maths,\n",
        "        \"Science\": science,\n",
        "        \"English\": english,\n",
        "        \"Total\": total,\n",
        "        \"Average\": round(average, 2),\n",
        "        \"Grade\": grade\n",
        "    })\n",
        "\n",
        "    st.success(f\"{name} added successfully!\")\n",
        "\n",
        "# Display Student Records\n",
        "if st.session_state.students:\n",
        "\n",
        "    st.subheader(\"Student Records\")\n",
        "\n",
        "    df = pd.DataFrame(st.session_state.students)\n",
        "\n",
        "    st.dataframe(df, use_container_width=True)\n",
        "\n",
        "    st.subheader(\"Class Statistics\")\n",
        "\n",
        "    st.metric(\"Total Students\", len(df))\n",
        "    st.metric(\"Class Average\", round(df[\"Average\"].mean(), 2))\n",
        "\n",
        "    st.bar_chart(\n",
        "        df.set_index(\"Name\")[[\"Math\", \"Science\", \"English\"]]\n",
        "    )\n",
        "\n",
        "    csv = df.to_csv(index=False).encode(\"utf-8\")\n",
        "\n",
        "    st.download_button(\n",
        "        label=\"📥 Download Report\",\n",
        "        data=csv,\n",
        "        file_name=\"student_report.csv\",\n",
        "        mime=\"text/csv\"\n",
        "    )"
